  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022  Snow leopards live alone and are so hard to spot that people call them the \u201Cghost of the mountains\u201D.\n\n\u2022  Their wide, furry paws work like snowshoes, so they don't sink into deep snow.\n\n\u2022  Their long, thick tail helps them balance on rocky cliffs, and they wrap it around themselves to keep warm.\n\n\u2022  Snow leopards can't roar. They hiss, growl and make a friendly puffing sound called a chuff."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 15cd8671454ddcc4d9f9d055c5bdea4b, type: 2}
  m_sharedMaterial: {fileID: 3060968202790619390, guid: 15cd8671454ddcc4d9f9d055c5bdea4b, type: 2}
