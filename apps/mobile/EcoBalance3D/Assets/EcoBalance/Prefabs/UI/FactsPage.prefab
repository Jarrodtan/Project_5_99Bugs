      m_Calls: []
  m_text: "\u2022  Blue sheep are excellent climbers and run up steep cliffs to escape snow leopards.\n\n\u2022  Their grey-blue coat matches the rocks, so when they stand still they are very hard to see.\n\n\u2022  They live in herds, so many eyes can watch out for danger.\n\n\u2022  Blue sheep are the snow leopard's main food in the Himalaya."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 15cd8671454ddcc4d9f9d055c5bdea4b, type: 2}
  m_sharedMaterial: {fileID: 3060968202790619390, guid: 15cd8671454ddcc4d9f9d055c5bdea4b, type: 2}
