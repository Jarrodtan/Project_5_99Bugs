# Normalise line endings across Windows / macOS / Ubuntu
* text=auto

# Unity YAML assets: merge as text, use Unity's Smart Merge where configured
*.unity   text merge=unityyamlmerge eol=lf
*.prefab  text merge=unityyamlmerge eol=lf
*.asset   text merge=unityyamlmerge eol=lf
*.meta    text eol=lf
*.cs      text diff=csharp

# Scripts: shell scripts must stay LF (Ubuntu/macOS), batch files CRLF (Windows)
*.sh      text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.psd  binary
*.fbx  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
