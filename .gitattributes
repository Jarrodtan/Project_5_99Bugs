# Normalise line endings across Windows / macOS / Ubuntu
* text=auto

# Unity YAML assets: merge as text, use Unity's Smart Merge where configured
*.unity   text merge=unityyamlmerge eol=lf
*.prefab  text merge=unityyamlmerge eol=lf
*.asset   text merge=unityyamlmerge eol=lf
*.meta    text eol=lf
*.cs      text diff=csharp

# Binary assets
*.png  binary
*.jpg  binary
*.psd  binary
*.fbx  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
